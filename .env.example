# =============================================================================
# SchoolMitra ERP — Monorepo Environment Configuration Matrix Template
# =============================================================================
# Governing Spec: edu-core-production-readiness-verification-p1 (v7.0.1)
# Copy this file to `.env` or `.env.local` for local deployment.
# NEVER commit production credentials or real secret keys to version control.
# =============================================================================

# ── Core Runtime & Node Environment ──────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SchoolMitra ERP"
NEXT_PUBLIC_APP_VERSION="0.1.0"
ANALYZE=false
NEXT_OUTPUT_STANDALONE=false
LOG_LEVEL=info

# ── Database (PostgreSQL with Drizzle ORM) ───────────────────────────────────
# Application database connection string (runs under non-owner role schoolmitra_app / schoolmitra_app_login)
DATABASE_URL="postgresql://schoolmitra_app_login:schoolmitra_app_secure@127.0.0.1:5444/schoolmitra_erp"
# Migration runner database connection string (runs under table owner role for DDL migrations)
MIGRATION_DATABASE_URL="postgresql://schoolmitra:schoolmitra_dev@127.0.0.1:5444/schoolmitra_erp"
# Optional migration/rotation secret password for schoolmitra_app_login (S6-T1)
APP_DB_PASSWORD=""
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DEBUG_DB=false

# ── Distributed Caching & Queues (Amazon ElastiCache for Valkey / Redis) ─────
# Primary for AWS deployments: Amazon ElastiCache for Valkey (33% lower cost, open source BSD-3)
VALKEY_URL="valkeys://default:your-auth-token@educore-valkey.c3e6ik6w4c0u.ap-south-1.cache.amazonaws.com:6379"
# Or component credentials if using individual parameters:
# VALKEY_HOST="educore-valkey.c3e6ik6w4c0u.ap-south-1.cache.amazonaws.com"
# VALKEY_PORT=6379
# VALKEY_PASSWORD="your-auth-token"
# Backward-compatible fallback (Redis OSS):
REDIS_URL="redis://localhost:6379"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ── Cryptography & Authentication ────────────────────────────────────────────
# AUTH_SECRET: Required in production. Minimum 32 characters (HMAC-SHA256 signing).
# Generate: openssl rand -base64 32
AUTH_SECRET="your-32-char-minimum-production-auth-secret-here"
AUTH_URL=http://localhost:3000

# IMPERSONATION_SECRET: Optional; falls back to AUTH_SECRET if unset.
IMPERSONATION_SECRET="your-32-char-minimum-impersonation-secret-here"

# ENCRYPTION_KEY: Required in production. Exactly 64 hex characters (32 bytes AES-256-GCM).
# Fails fast at startup in production if missing.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_KEY_ID="k1"
# ENCRYPTION_KEYRING: Optional JSON key map for zero-downtime key rotation
ENCRYPTION_KEYRING=""

# ── Progressive Web App (PWA) & Web Push (VAPID) ──────────────────────────────
NEXT_PUBLIC_ENABLE_PWA="true"
NEXT_PUBLIC_SW_SCOPE="/"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@schoolmitra.com"

# ── Payment Gateway (Razorpay) ────────────────────────────────────────────────
# Required for Fee collection and payment webhooks.
RAZORPAY_KEY_ID="rzp_test_key_id"
RAZORPAY_KEY_SECRET="rzp_test_secret_key"
RAZORPAY_WEBHOOK_SECRET="rzp_test_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_key_id"

# ── Object Storage (AWS S3 / MinIO) ──────────────────────────────────────────
# Required in production for documents, photo uploads, and report generation.
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="schoolmitra-documents"
S3_BUCKET_DOCUMENTS="schoolmitra-documents"
S3_BUCKET_PHOTOS="schoolmitra-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"

# ── Transactional Email (SMTP) ────────────────────────────────────────────────
# Required for transactional notifications, reports, and alerts.
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="SchoolMitra Notifications <notifications@schoolmitra.in>"

# ── SMS Gateway & DLT Credentials ─────────────────────────────────────────────
# Required for parent SMS notifications and OTP delivery in India.
SMS_PROVIDER=mock
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_DLT_PE_ID=""
SMS_DLT_TEMPLATE_ID=""
SMS_GATEWAY_URL=""
# Optional Twilio provider credentials:
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── Background Worker & Automation ───────────────────────────────────────────
START_WORKERS=true
CRON_SECRET="your-production-cron-secret"

# ── Database Seeding & Administration ────────────────────────────────────────
SUPER_ADMIN_EMAIL="admin@schoolmitra.in"
SUPER_ADMIN_PASSWORD="change-me-immediately"
