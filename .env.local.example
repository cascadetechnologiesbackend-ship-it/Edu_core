# =============================================================================
# SchoolMitra ERP — Local Environment Configuration Template
# =============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit production secrets or real customer credentials to git.
# =============================================================================

# ── Application Environment ──────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SchoolMitra ERP"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://schoolmitra:schoolmitra_dev@127.0.0.1:5444/schoolmitra_erp"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Authentication (NextAuth v5 / Auth.js) ──────────────────────────────────
# Required in production: minimum 32 characters long.
# Generate: openssl rand -base64 32
AUTH_SECRET="dev-secret-minimum-32-characters-long-example-key-12345"
AUTH_URL=http://localhost:3000

# Dedicated secret for signing cryptographic impersonation tokens (falls back to AUTH_SECRET if unset)
IMPERSONATION_SECRET="dev-impersonation-secret-minimum-32-characters-long-key-123"

# ── Encryption (AES-256 for student PII fields) ──────────────────────────────
# Required in production: exactly 64 hexadecimal characters (32 bytes).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
ENCRYPTION_IV_LENGTH=16

# ── Object Storage (S3 / MinIO) ──────────────────────────────────────────────
# In local development, MinIO is used. In production, provide AWS credentials.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="ap-south-1"
S3_BUCKET="schoolmitra-documents"
S3_BUCKET_DOCUMENTS="schoolmitra-documents"
S3_BUCKET_PHOTOS="schoolmitra-photos"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
S3_SIGNED_URL_EXPIRY_SECONDS=900

# ── Razorpay Payment Gateway ─────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_key"
RAZORPAY_KEY_SECRET="change-me"
RAZORPAY_WEBHOOK_SECRET="change-me"

# ── Transactional Email (SMTP / Amazon SES / Resend) ──────────────────────────
# Required in production for OTP, notifications, admission receipts, and billing.
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="SchoolMitra <notifications@schoolmitra.in>"
